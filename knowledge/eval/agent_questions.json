{
 "version": "phase3-agent-eval-v1",
 "created_at": "2026-10-24",
 "agent_version": "phase3-agent-v1",
 "environment": {
  "industrial_database": "industrial_agent_audit（生产只读；1,516,948 行真实数据 / 4 条官方故障事件）",
  "knowledge_database": "iaa_rag_dev（Phase 2 知识库：6 份文档 / 1,314 Chunk）",
  "llm": "Ollama qwen2.5:7b-instruct",
  "embedding": "Ollama bge-m3 (1024 维)"
 },
 "metric_definition": {
  "tool_selection": "required=expected_tools；actual=本次实际执行的工具集合（含失败调用）；额外工具仅在 allowed_tools 内不算错误",
  "tool_precision": "|required∩actual| / |actual|",
  "tool_recall": "|required∩actual| / |required|",
  "tool_exact_match": "precision==1 且 recall==1",
  "status_match": "execution_status == expected_status（rejected 表示服务入口直接拒绝）",
  "numeric_check": "回答中必须出现与期望值差值 ≤ tolerance 的数值（期望值由直接 SQL/Service 计算，不经 Agent）",
  "citation_check": "期望的 doc_key 与页码区间被引用（页面级代理指标，不判断语义充分性）",
  "citation_verbatim": "被引用的每个 Chunk 的 quote 必须逐字出现在该 Chunk 原文中（数据库核对）",
  "unsupported_conclusion": "回答中出现确诊式措辞（已确认故障/确诊/必然/一定是故障）或数值接地违规"
 },
 "notes": [
  "本题集的期望数值与页码均由人工用 Service/数据库与 Phase 2 文档页码核对，不由 Agent 或同一个 LLM 生成。",
  "expected_tools 是“必需工具”，allowed_tools 是“可接受的额外工具”，用于避免把合理的补充查询误判为错误。",
  "F03 期望在服务入口被拒绝（对应 HTTP 422），因为带时区的请求不做任何静默换算。",
  "工具执行失败（超时/知识库不可达）不在题目里伪造，而是由 evaluate_agent.py 的 fault_scenarios 注入真实故障后评估。"
 ],
