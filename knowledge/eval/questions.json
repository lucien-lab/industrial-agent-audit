{
  "version": "rag-eval-v1",
  "created_at": "2026-10-22",
  "knowledge_index": {
    "chunking_versions": [
      "structural-v1",
      "fixed-v1"
    ],
    "embedding_model": "bge-m3",
    "embedding_version": "bge-m3-1024-v1",
    "embedding_dim": 1024
  },
  "metric_definition": {
    "relevance": "每条 expected 是一项“证据需求”：doc_key 相同且 Chunk 页码区间与 pages 中任一页有交集，即满足该需求；also_ok 列出同样可接受的其它文档/页码。",
    "recall_at_5": "每题的 |已满足的证据需求| / |证据需求总数|，再对所有可回答题取宏平均（多文档题按需求分别计分）",
    "hit_rate_at_5": "Top-5 中至少命中一条预期证据的题目占比（可回答题）",
    "mrr_at_10": "Top-10 中第一条相关结果的倒数排名，可回答题取宏平均",
    "precision_at_5": "Top-5 中相关结果数 / min(5, 返回数)，可回答题取宏平均",
    "note": "预期证据由人工依据原文页码标注（见每题的 basis 字段），不是由模型生成。页码为 PDF 物理页码（从 1 开始）。"
  },
  "generation_rubric": {
    "evidence_supported": "回答中的事实性断言都能在上文列出的引用 Chunk 中找到依据",
    "citation_correct": "引用标签对应的文档与页码确实包含该断言所需的信息",
    "unsupported_claims": "出现了引用 Chunk 中没有的数字、型号、阈值或故障结论",
    "refusal_correct": "对 must_refuse=true 的问题，明确说明无法确认且未给出具体参数/结论",
    "labels": [
      "yes",
      "partial",
      "no"
    ]
  },
