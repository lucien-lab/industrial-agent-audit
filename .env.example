# 仅说明配置项，不含任何真实密码；实际值写入被 .gitignore 忽略的 .env。
# 复制为 .env 后填写：cp .env.example .env
#
# PostgreSQL（由 docker-compose.yml 启动，pgvector 镜像）
POSTGRES_DB=industrial_agent_audit
POSTGRES_USER=app_user
# 请自行生成本地密码，禁止提交真实值
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

# 被测代码与脚本使用的连接串（必须使用 psycopg 3 驱动）
DATABASE_URL=postgresql+psycopg://app_user:change-me-locally@127.0.0.1:5432/industrial_agent_audit

# pytest / 迁移验证使用的**独立测试库**，库名必须以 _test 结尾
POSTGRES_TEST_DB=industrial_agent_audit_test
TEST_DATABASE_URL=postgresql+psycopg://app_user:change-me-locally@127.0.0.1:5432/industrial_agent_audit_test
ALEMBIC_DATABASE_URL=postgresql+psycopg://app_user:change-me-locally@127.0.0.1:5432/industrial_agent_audit

# 阶段 1C：真实工业数据只读验证（可选）。
# 指向一份已迁移到 head 的全量数据副本，测试才会运行 test_api_real_data.py；不设置则跳过。
# IAA_FULLDATA_DATABASE_URL=postgresql+psycopg://app_user:change-me-locally@127.0.0.1:5432/iaa_rehearsal2_test

# 后续阶段使用，本阶段留空
LLM_API_KEY=
LLM_MODEL=to-be-selected
EMBEDDING_MODEL=to-be-selected

LOG_LEVEL=INFO

# --------------------------------------------------------------------------- #
# 阶段 2：RAG 知识库
# --------------------------------------------------------------------------- #
# 知识库可能位于独立库（推荐先用隔离库验证迁移 0007），未设置时回退 DATABASE_URL
# RAG_DATABASE_URL=postgresql+psycopg://app_user:change-me-locally@127.0.0.1:5432/iaa_rag_dev
KNOWLEDGE_ROOT=./knowledge

# Embedding：默认本地 Ollama bge-m3（实测输出 1024 维，无需 API Key）
# 换模型必须同时更换 EMBEDDING_VERSION 并全量重建索引（vector 维度变化还需新增迁移）
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_VERSION=bge-m3-1024-v1
EMBEDDING_BATCH_SIZE=8
EMBEDDING_TIMEOUT_S=120
EMBEDDING_MAX_RETRIES=3
# 使用 openai 兼容服务时填写；不要提交真实值
EMBEDDING_API_KEY=

# LLM：默认本地 Ollama qwen2.5:7b-instruct（中文可用，显存需求低）
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:7b-instruct
LLM_TIMEOUT_S=180
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.0
LLM_NUM_CTX=8192
LLM_MAX_TOKENS=900
LLM_API_KEY=

# 切分与检索参数（默认值，可被 CLI 覆盖）
CHUNKING_STRATEGY=structural
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
CHUNKING_VERSION=structural-v1
RAG_TOP_K=5
RAG_MAX_TOP_K=20
RRF_K=60
VECTOR_CANDIDATES=30
KEYWORD_CANDIDATES=30
RAG_MAX_CONTEXT_CHARS=12000
RAG_MAX_CHUNK_CHARS=2400

# --------------------------------------------------------------------------- #
# 阶段 3：工业运维 Agent（LangGraph 单 Agent + 多工具）
# 说明：本文件由 app/core/config.py 的 load_env_file 解析，只支持 KEY=VALUE 与整行注释，
# 因此**不要把说明写在值的同一行**（会被当成值的一部分）。
# --------------------------------------------------------------------------- #
# 预算与超时（第一版默认值，评估后可调；超出硬上限会在启动时报错）
# AGENT_MAX_TOOL_CALLS: 最大工具调用次数（硬上限 32）
AGENT_MAX_TOOL_CALLS=8
# AGENT_MAX_ROUNDS: 最大决策轮次（硬上限 20）
AGENT_MAX_ROUNDS=5
# AGENT_MAX_GRAPH_STEPS: 节点步数保险（另有 LangGraph recursion_limit）
AGENT_MAX_GRAPH_STEPS=24
# AGENT_TOTAL_TIMEOUT_S: 整轮执行截止时间（秒）
AGENT_TOTAL_TIMEOUT_S=180
# AGENT_DATA_TOOL_TIMEOUT_S: 数据工具单次超时（秒）
AGENT_DATA_TOOL_TIMEOUT_S=20
# AGENT_STATISTICS_TIMEOUT_S: 统计工具单次超时（秒）
AGENT_STATISTICS_TIMEOUT_S=40
# AGENT_KNOWLEDGE_TOOL_TIMEOUT_S: 知识检索单次超时（秒）
AGENT_KNOWLEDGE_TOOL_TIMEOUT_S=60
# AGENT_TOOL_MAX_RETRIES: 仅 timeout / transient 类别重试
AGENT_TOOL_MAX_RETRIES=1

# 输入与返回量限制
AGENT_MAX_QUESTION_CHARS=500
AGENT_MAX_HISTORY_ROWS=200
AGENT_MAX_FAULT_EVENTS=20
AGENT_MAX_KNOWLEDGE_CHUNKS=5
AGENT_MAX_KNOWLEDGE_TOP_K=8
AGENT_MAX_EVIDENCE_CHARS=9000

# 行为开关
# AGENT_PLANNER: rule（默认，确定性规则）/ llm（模型在注册表内选工具，仅用于对比实验）
AGENT_PLANNER=rule
# AGENT_ANSWER_MODE: auto（默认）/ llm / deterministic
AGENT_ANSWER_MODE=auto
# AGENT_STRICT_NUMERIC_GROUNDING: 回答出现证据外数值时降级为确定性渲染
AGENT_STRICT_NUMERIC_GROUNDING=true
# AGENT_DEFAULT_EQUIPMENT_CODE: 请求未给 equipment_id 时的默认设备（回答中会注明）
AGENT_DEFAULT_EQUIPMENT_CODE=metropt3-apu-01
# AGENT_DEFAULT_YEAR: 问题只写“4月17日”时使用的年份（回答中会注明）
AGENT_DEFAULT_YEAR=2020

# 执行 Trace（供后续 Agent-Probe 消费）
AGENT_TRACE_DIR=./data/processed/agent/traces
AGENT_TRACE_WRITE_FILES=true
AGENT_TRACE_MEMORY_SIZE=200

# 若开发机开启了系统 HTTP 代理，本机模型服务需要绕过代理。
# 代码会为目标为 127.0.0.1 / localhost 的请求自动补充 NO_PROXY；如需自定义可显式设置：
# NO_PROXY=127.0.0.1,localhost

# ---- 阶段 4：Agent-Probe 审计 ----
# AUDIT_DATABASE_URL: 独立审计写库（禁止指向主库 DATABASE_URL；不自动迁移主库）
# 本地开发可创建 iaa_audit_dev；测试使用 TEST_DATABASE_URL。
AUDIT_DATABASE_URL=postgresql+psycopg://app_user:change_me@127.0.0.1:5432/iaa_audit_dev
# 仅在明确知情时允许审计库等于 DATABASE_URL（默认拒绝）
AUDIT_ALLOW_MAIN_DATABASE=false

# 审计默认模式：rule_only / llm_only / hybrid
AUDIT_DEFAULT_MODE=hybrid
# 是否开启 LLM 语义审计（关闭时 llm_only/hybrid 会得到 UNKNOWN 并要求人工复核）
AUDIT_JUDGE_ENABLED=true
AUDIT_JUDGE_PROVIDER=ollama
AUDIT_JUDGE_MODEL=qwen2.5:7b-instruct
AUDIT_JUDGE_BASE_URL=http://127.0.0.1:11434
AUDIT_JUDGE_TIMEOUT_S=120
# 有限重试：仅用于解析失败/调用失败；失败不会被当成通过
AUDIT_JUDGE_MAX_RETRIES=1
AUDIT_JUDGE_TEMPERATURE=0.0
AUDIT_JUDGE_MAX_TOKENS=1800
AUDIT_JUDGE_MAX_INPUT_CHARS=12000
AUDIT_JUDGE_PROMPT_VERSION=audit-judge-v7

# Agent 执行完成后自动审计（默认关闭；失败不影响原始回答与 Trace）
AUDIT_AUTO_ON_CHAT=false
# 是否读取知识库原文核对 Chunk（true 时会在报告中记录外部读取，不属于纯冻结 Trace 回放）
AUDIT_VERIFY_KNOWLEDGE_OFFLINE=false

# 规则阈值（修改任何一项都会产生新的 rule_config_version）
AUDIT_MAX_TOOL_CALLS=8
AUDIT_MAX_ROUNDS=5
AUDIT_MAX_GRAPH_STEPS=24
AUDIT_TOTAL_TIMEOUT_S=180
AUDIT_MAX_IDENTICAL_CALLS=1
AUDIT_MIN_SAMPLE_COVERAGE=0.95
AUDIT_MIN_TIME_COVERAGE=0.95
AUDIT_NUMERIC_REL_TOLERANCE=0.001

# 审计 API 共享令牌（留空 = 不校验，仅应绑定本机/隔离环境）
AUDIT_API_TOKEN=
AUDIT_API_HOST_SCOPE=local_only
